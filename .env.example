# Copy to .env and fill in. Generate a key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Relative sqlite paths resolve against the Flask instance/ folder,
# so this means instance/maintenance_tracker.db
DATABASE_URL=sqlite:///maintenance_tracker.db

# Optional: set to 1 to enable debug mode (never in production)
FLASK_DEBUG=1

# Optional: bind address. Default is 127.0.0.1; use 0.0.0.0 to allow
# other devices on your network to reach the app.
# HOST=0.0.0.0

# --- Follow-up email sending (optional) ---
# Leave SMTP_USERNAME/SMTP_PASSWORD blank to disable sending; the follow-up
# composer still works as "record without emailing".
# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it here (spaces are ok).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_NAME=Maintenance Tracker
# For local email testing only: point SMTP_HOST/PORT at a test sink
# (e.g. `python -m aiosmtpd -n -l localhost:1025`) and set SMTP_STARTTLS=0
# to skip TLS + login. Never disable this for a real provider.
# SMTP_STARTTLS=0

# Days before an active job is due another follow-up (due-followups queue)
FOLLOW_UP_DAYS=7
